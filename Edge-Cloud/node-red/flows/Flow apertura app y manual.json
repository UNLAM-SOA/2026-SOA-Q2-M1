        "func": "const bcrypt = global.get('bcrypt');\nconst user = msg.payload[0];\n\nif (!user) {\n    msg.statusCode = 401;\n    msg.payload = { error: \"Credenciales incorrectas\" };\n    return msg;\n}\n\nif (!user.activo) {\n    msg.statusCode = 403;\n    msg.payload = { error: \"Usuario no activo\" };\n    return msg;\n}\n\nmsg.statusCode = 200;\nmsg.payload = { ok: true, nombre: user.nombre, estado: user.activo };\nreturn msg;",
