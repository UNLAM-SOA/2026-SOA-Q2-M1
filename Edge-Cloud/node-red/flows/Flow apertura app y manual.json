    {
        "id": "a4c16f5c98e7c755",
        "type": "function",
        "z": "d6556849d0225941",
        "name": "Contador de personas en gimnasio",
        "func": "const {cantidad} = msg.payload;\nconst nombreContadorPersonas = \"contador_personas\";\n\nif (!global.get(nombreContadorPersonas)) {\n    global.set(nombreContadorPersonas, 0);\n}\n\nif (global.get(nombreContadorPersonas) == 0 && cantidad < 1) {\n    msg.payload = {\n        cantidadPersonasActual: 0\n    }\n\n    return msg;\n}\n\nglobal.set(nombreContadorPersonas, global.get(nombreContadorPersonas) + cantidad);\n\nmsg.payload = {\n    cantidadPersonasActual: global.get(nombreContadorPersonas)\n}\n\nreturn msg;",
