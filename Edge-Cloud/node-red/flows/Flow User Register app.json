    {
        "id": "0f6781af4c67fbce",
        "type": "function",
        "z": "f931bcdef6cf04d3",
        "name": "Validador Datos",
        "func": "const { dni, clave, nombre, apellido } = msg.payload;\n\nif (!/^\\d{7,8}$/.test(dni) || typeof clave !== \"string\" || clave.length > 100\n        || typeof nombre !== \"string\" || typeof apellido !== \"string\" ) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"Datos inválidos\" };\n    return [null, msg];\n}\n\nmsg.dni = dni;\nmsg.clave = clave;\nmsg.nombre = nombre + \" \" + apellido;\n\nreturn [msg, null];",
