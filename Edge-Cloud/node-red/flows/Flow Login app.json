        "z": "c3d568ec7035ded3",
        "name": "Validador DNI",
        "func": "const { dni, clave } = msg.req.query;\n\nif (!/^\\d{7,8}$/.test(dni) || typeof clave !== \"string\" || clave.length > 100) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"Datos inválidos\" };\n    return [null, msg];\n}\n\nmsg.dni = dni;\nmsg.clave = clave;\nreturn [msg, null];",
