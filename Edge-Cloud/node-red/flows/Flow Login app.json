    {
        "id": "164e583148b68925",
        "type": "function",
        "z": "c3d568ec7035ded3",
        "name": "Validador clave",
        "func": "const bcrypt = global.get('bcrypt');\nconst user = msg.payload[0];\n\nif (!user || !user.activo) {\n    msg.statusCode = 401;\n    msg.payload = { error: \"Credenciales incorrectas\" };\n    return msg;\n}\n\nconst ok = await bcrypt.compare(msg.clave, user.password_hash);\n\nif (!ok) {\n    msg.statusCode = 401;\n    msg.payload = { error: \"Credenciales incorrectas\" };\n    return msg;\n}\n\nmsg.statusCode = 200;\nmsg.payload = { ok: true, nombre: user.nombre, estado: user.activo};\nreturn msg;",
