    {
        "id": "84d49ea5ef8cfc05",
        "type": "function",
        "z": "43c0f7151383508b",
        "name": "Armar query para tablas y datos de pruebas",
        "func": "msg.query = `\n    CREATE TABLE IF NOT EXISTS usuarios(\n        id SERIAL PRIMARY KEY,\n        dni VARCHAR(8) UNIQUE NOT NULL, \n        nombre VARCHAR(100), \n        password_hash VARCHAR(100) NOT NULL,\n        activo BOOLEAN NOT NULL DEFAULT TRUE\n    );\n\n    CREATE TABLE IF NOT EXISTS eventos_puerta(\n        id SERIAL PRIMARY KEY, \n        usuario_id INT REFERENCES usuarios(id),\n        tipo VARCHAR(30) NOT NULL,\n        fecha TIMESTAMPTZ NOT NULL DEFAULT NOW()\n    );\n\n    CREATE EXTENSION IF NOT EXISTS pgcrypto;\n    INSERT INTO usuarios(dni, nombre, password_hash)\n    VALUES('40123456', 'Usuario Prueba',\n        crypt('40123456' || '40123456', gen_salt('bf')))\n    ON CONFLICT(dni) DO NOTHING;\n\n    INSERT INTO usuarios(dni, nombre, password_hash)\n    VALUES('1234567', 'Usuario Prueba 2',\n        crypt('1234567' || '1234567', gen_salt('bf')))\n    ON CONFLICT(dni) DO NOTHING;\n`;\nreturn msg;",
